rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.id is string &&
             data.name is string && data.name.size() > 0 &&
             data.role in ['DONOR', 'NGO', 'VOLUNTEER'] &&
             data.organization is string &&
             data.email is string;
    }

    function isValidFoodDonation(data) {
      return data.id is string &&
             data.donorId is string &&
             data.donorOrg is string &&
             data.title is string && data.title.size() > 0 &&
             data.quantityMeals is int && data.quantityMeals > 0 &&
             data.foodType in ['VEG', 'NON_VEG', 'VEGAN', 'BAKERY', 'PACKAGED'] &&
             data.status in ['PENDING', 'CLAIMED', 'OUT_FOR_DELIVERY', 'DELIVERED', 'CANCELLED'];
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isValidUserProfile(request.resource.data);
    }

    // Food donations
    match /food_donations/{donationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                      request.resource.data.donorId == request.auth.uid &&
                      isValidFoodDonation(request.resource.data);
      allow update: if isAuthenticated() &&
                      isValidFoodDonation(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.donorId == request.auth.uid;
    }
  }
}
